// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

enum BlogCategory {
  Music
  Culture
  Lifestyle
  News
  Industry
}

enum VideoCategory {
  Music_Video
  Dance
  Interview
  Vlog
  Performance
}

enum ChartTrend {
  up
  down
  same
  new
}

enum ChartType {
  song
  album
}

model User {
  id            String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image         String?
  password      String?   // Hashed password for credentials authentication
  passwordSalt  String?   // Salt for password hashing (Edge-compatible)
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  blogPosts     BlogPost[]
  comments      Comment[]
  accounts      Account[]
  sessions      Session[]
  
  @@index([email])
}

model BlogPost {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String       @db.Text
  content     String       @db.Text
  authorId    String
  category    BlogCategory
  featured    Boolean      @default(false)
  imageUrl    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Full-text search vector (managed via migrations)
  searchVector String?     @db.Text
  
  // Relations
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  
  @@index([slug])
  @@index([category])
  @@index([featured])
  @@index([createdAt])
  @@map("blog_posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String?
  author    String   // Guest author name
  content   String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  post      BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  @@index([postId])
  @@index([createdAt])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  youtubeId   String        @unique
  thumbnailUrl String?
  duration    String
  views       String
  date        String
  category    VideoCategory
  featured    Boolean       @default(false)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model ChartEntry {
  id            String     @id @default(cuid())
  rank          Int
  title         String
  artist        String
  coverUrl      String
  trend         ChartTrend
  lastWeek      Int?
  peak          Int
  weeksOnChart  Int
  type          ChartType
  previewUrl    String?
  spotifyLink   String?
  appleMusicLink String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([type, rank])
  @@index([createdAt])
  @@map("chart_entries")
}

model Artist {
  id         String   @id @default(cuid())
  name       String   @unique
  imageUrl   String
  genre      String
  socialLink String?
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([name])
}

model TrendingTopic {
  id        String   @id @default(cuid())
  name      String   @unique
  count     String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([name])
  @@map("trending_topics")
}

model Poll {
  id        String   @id @default(cuid())
  question  String   @db.Text
  options   Json     // Array of { id, text, votes }
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([active])
  @@map("polls")
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  subscribedAt     DateTime  @default(now())
  active           Boolean   @default(true)
  verified         Boolean   @default(false)
  verificationToken String?  @unique
  verifiedAt       DateTime?
  unsubscribedAt   DateTime?
  
  @@index([email])
  @@index([active])
  @@index([verified])
  @@index([verificationToken])
  @@map("newsletter_subscribers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at       Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

